{
  "name": "project-root",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently -n \"VITE,TAILWIND,PHP\" -c \"bgBlue.bold,bgGreen.bold,bgMagenta.bold\" \"npm run dev\" \"npm run tailwind\" \"npm run php-server\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tailwind": "npx tailwindcss -i ./src/styles/input.css -o ./public/assets/css/output.css --watch",
    "prepare": "husky install"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.24.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "chalk": "^5.4.1",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "husky": "^9.0.0",
    "jest": "^30.0.5",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.3.3",
    "vite": "^7.0.5",
    "vite-plugin-php": "^1.0.651"
  }
}
